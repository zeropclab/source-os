# SourceOS Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://postgres:sourceos@localhost:5432/sourceos

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_ROOT=./data

# YouTube Data API (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=

# Sentry (optional, https://sentry.io)
SENTRY_DSN=

# Web UI basic auth (optional)
WEB_USERNAME=admin
WEB_PASSWORD=sourceos

# Logging
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
